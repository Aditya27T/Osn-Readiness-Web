# ==============================================================================
# OSN MONOREPO - DOCKER COMPOSE CONFIGURATION
# Salin file ini menjadi .env sebelum menjalankan docker compose
# ==============================================================================

# Port pada Host Mesin
FRONTEND_PORT=5173
BACKEND_PORT=8000
ANALYTICS_PORT=8001

# Database Backend (PostgreSQL)
APP_DB_PORT=5432
APP_DB_DATABASE=osn_readiness
APP_DB_USERNAME=sail
APP_DB_PASSWORD=password

# Database Data Analytics (PostgreSQL + pgvector)
ANALYTICS_DB_PORT=5433
ANALYTICS_DB_DATABASE=analytics
ANALYTICS_DB_USERNAME=analytics
ANALYTICS_DB_PASSWORD=changeme-generate-a-real-secret

# Shared Secret Token antara Laravel dan FastAPI
INTERNAL_API_TOKEN=changeme-generate-a-real-secret
