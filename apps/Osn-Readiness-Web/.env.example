APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=osn_readiness
DB_USERNAME=sail
DB_PASSWORD=password
# Testing memakai database terpisah (lihat phpunit.xml)
DB_TEST_DATABASE=osn_readiness_testing

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Masa berlaku token Sanctum dalam menit (7 hari).
SANCTUM_EXPIRATION=10080

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=password

# Akun siswa contoh. Dipakai e2e/helpers.js sebagai AKUN_SISWA dan oleh
# auth.spec.js untuk menguji penolakan email yang sudah dipakai.
SISWA_CONTOH_EMAIL=siswa@example.com
SISWA_CONTOH_PASSWORD=password

# Masa retensi akun yang sudah dihapus, dalam hari (dipakai PurgeAkunJob).
RETENSI_AKUN_HARI=30

# Folder impor bank soal kabupaten dari repo data-analytics, untuk seeder
# pengembangan. Berisi materi/*.md, soal_*.json, dan gambar/. Kosongkan bila
# tidak ada; KontenKabupatenSeeder lalu dilewati dengan peringatan.
KONTEN_KABUPATEN_FOLDER=

# Layanan hitung Python (lihat PerhitunganClientInterface).
# Kalau Laravel jalan di Sail, "localhost" berarti container itu sendiri dan
# Python di host tidak akan terjangkau. Ganti jadi host.docker.internal:
#   PERHITUNGAN_URL=http://host.docker.internal:8001
PERHITUNGAN_URL=http://localhost:8001
PERHITUNGAN_TOKEN=
PERHITUNGAN_TIMEOUT=5
PERHITUNGAN_RETRY=2
